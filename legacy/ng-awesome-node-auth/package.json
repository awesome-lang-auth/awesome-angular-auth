  "description": "Renamed to @awesome-lang-auth/angular. This last version only re-exports @awesome-lang-auth/angular: install that package instead.",
  "author": "Nicola Brecciaroli",
  "license": "MIT",
  "homepage": "https://www.awesomenodeauth.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesome-lang-auth/awesome-angular-auth.git",
    "directory": "legacy/ng-awesome-node-auth"
  },
  "bugs": {
    "url": "https://github.com/awesome-lang-auth/awesome-angular-auth/issues"
  },
  "keywords": [
    "auth",
    "angular",
    "awesome-lang-auth",
    "awesome-node-auth",
    "deprecated"
  ],
  "type": "module",
